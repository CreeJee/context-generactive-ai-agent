<?xml version="1.0" encoding="UTF-8"?>
<!--
  What the hardened runtime has to allow for this executable. Notarization requires the hardened
  runtime, and the hardened runtime denies these by default, so each one is here because the
  executable does not start without it.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 compiles JavaScript to machine code at run time. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!--
    The native add-ons (turbovec, onnxruntime, sharp, keyring) are unpacked from the executable to
    <storage>/runtime on first start and loaded from there. They carry their publishers' signatures,
    not ours, and library validation would refuse to load them.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
