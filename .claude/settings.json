{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PATH=\"$HOME/.local/share/vite-plus/bin:$PATH\" node lint/wording/check/main.ts hook",
            "timeout": 60,
            "statusMessage": "문구 검사"
          }
        ]
      }
    ]
  }
}
