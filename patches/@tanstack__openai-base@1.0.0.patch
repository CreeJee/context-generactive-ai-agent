-			runId: generateId(this.name),
+			runId: options.runId ?? generateId(this.name),
 			threadId: options.threadId,
 			messageId: generateId(this.name),
 			hasEmittedRunStarted: false
@@ -231,7 +231,7 @@ var OpenAIBaseChatCompletionsTextAdapter = class extends BaseTextAdapter {
 		const requestParams = this.mapOptionsToRequest(jsonMode ? withJsonModePrompt(chatOptions, outputSchema) : chatOptions);
 		const responseFormat = this.chatCompletionsResponseFormat(jsonMode, outputSchema);
