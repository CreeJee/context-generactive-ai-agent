{
  "name": "context-generactive-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run --no-cache agent#package",
    "start": "node apps/agent/dist/context-agent.mjs",
    "test:browser": "vp test --config apps/agent/vite.browser.config.ts --run",
    "typecheck": "vp run -r typecheck",
    "ready": "vp check && vp run -r typecheck && vp run -r test && vp run -r build",
    "dev": "vp run agent#dev",
    "dev:rrsi": "node apps/agent/scripts/dev-rrsi.ts",
    "dev:agent": "pnpm --filter agent dev:agent",
    "dev:web": "pnpm --filter agent dev:web",
    "prepare": "vp config && effect-tsgo patch --typescript"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@shadcn/lint": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.8.2"
  }
}
