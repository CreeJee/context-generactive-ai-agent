{
  "name": "context-generactive-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run --no-cache agent#package",
    "start": "node apps/agent/dist/context-agent.mjs",
    "test:browser": "vp test --config apps/agent/vite.browser.config.ts --run",
    "typecheck": "typecheck_result=0; vp run agent#typecheck || typecheck_result=1; vp run memory-agent#typecheck || typecheck_result=1; vp run utils#typecheck || typecheck_result=1; tsc -p apps/agent/server/tests/tsconfig.json --noEmit || typecheck_result=1; tsc -p tools/profile/tsconfig.json || typecheck_result=1; exit $typecheck_result",
    "ready": "vp check && vp run typecheck && vp run -r test && vp run -r build",
    "dev": "vp run agent#dev",
    "dev:agent": "pnpm --filter agent dev:agent",
    "dev:web": "pnpm --filter agent dev:web",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@shadcn/lint": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "catalog:",
    "zod": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.8.2"
  }
}
