{
  "name": "memory-agent",
  "version": "0.0.0",
  "private": true,
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "bin": {
    "context-agent-acp": "./bin/context-agent-acp.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./definitions": "./src/tools/definitions.ts",
    "./package.json": "./package.json",
    "./acp": "./src/acp/index.ts",
    "./kiwi-worker": "./src/memory/morph/kiwi-worker.mjs",
    "./embed-worker": "./src/memory/embedding/embed-worker.mjs",
    "./import-worker": "./src/imports/worker.ts",
    "./redact-worker": "./src/secrets/redact-worker.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "check": "vp check",
    "eval:recall": "node --no-warnings eval/recall.ts",
    "eval:compaction": "node --no-warnings eval/compaction-cli.ts",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@huggingface/transformers": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@napi-rs/keyring": "catalog:",
    "@secretlint/core": "catalog:",
    "@secretlint/profiler": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-anthropic": "catalog:",
    "@tanstack/ai-client": "catalog:",
    "@tanstack/ai-compaction": "catalog:",
    "@tanstack/ai-mcp": "catalog:",
    "@tanstack/ai-openai": "catalog:",
    "@tanstack/ai-persistence": "catalog:",
    "cross-spawn": "catalog:",
    "dayjs": "catalog:",
    "effect": "catalog:",
    "js-tiktoken": "catalog:",
    "kiwi-nlp": "catalog:",
    "sharp": "catalog:",
    "turbovec": "workspace:*",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
