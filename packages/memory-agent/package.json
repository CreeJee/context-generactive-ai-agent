{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "name": "memory-agent",
  "version": "0.0.0",
  "private": true,
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "bin": {
    "context-agent-acp": "./bin/context-agent-acp.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./native-effect": "./src/runtime/native-effect.ts",
    "./node-platform": "./src/runtime/node-platform.ts",
    "./host-system": "./src/runtime/host-system.ts",
    "./runtime-resources": {
      "types": "./src/runtime/resources.ts",
      "development": "./src/runtime/resources.ts",
      "import": "./src/runtime/resources.ts",
      "default": "./src/runtime/resources.ts"
    },
    "./definitions": "./src/tools/definitions.ts",
    "./provider-contracts": "./src/providers/contracts.ts",
    "./compatible-config": "./src/providers/openai-compatible-config.ts",
    "./package.json": "./package.json",
    "./acp": "./src/acp/index.ts",
    "./kiwi-worker": "./src/memory/morph/kiwi-worker.ts",
    "./embed-worker": "./src/memory/embedding/embed-worker.ts",
    "./import-worker": "./src/imports/worker.ts",
    "./redact-worker": "./src/secrets/redact-worker.ts",
    "./native-search-worker": "./src/memory/native-search/worker.ts",
    "./sandbox-worker": "./src/shell/sandbox-worker.ts",
    "./code-worker": "./src/code/worker.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "check": "vp check",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "eval:recall": "node --no-warnings eval/recall.ts",
    "eval:compaction": "node --no-warnings eval/compaction-cli.ts",
    "eval:structured-memory": "node --no-warnings eval/structured-memory.ts",
    "eval:memory-lab": "node --no-warnings eval/memory-research-lab.ts",
    "eval:prompt-overhead": "node --no-warnings eval/prompt-overhead.ts",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@anthropic-ai/sandbox-runtime": "catalog:",
    "@cfworker/json-schema": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@huggingface/transformers": "catalog:",
    "@jitl/quickjs-singlefile-mjs-release-sync": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@napi-rs/keyring": "catalog:",
    "@secretlint/core": "catalog:",
    "@secretlint/profiler": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-anthropic": "catalog:",
    "@tanstack/ai-client": "catalog:",
    "@tanstack/ai-compaction": "catalog:",
    "@tanstack/ai-mcp": "catalog:",
    "@tanstack/ai-openai": "catalog:",
    "@tanstack/ai-persistence": "catalog:",
    "cross-spawn": "catalog:",
    "dayjs": "catalog:",
    "effect": "catalog:",
    "js-tiktoken": "catalog:",
    "kiwi-nlp": "catalog:",
    "minimatch": "catalog:",
    "quickjs-emscripten-core": "catalog:",
    "sharp": "catalog:",
    "sucrase": "catalog:",
    "turbovec": "workspace:*",
    "undici": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
